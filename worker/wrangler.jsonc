{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "scotty-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": [
      "/api/*",
      "/s/*",
      "/sessions",
      "/devices",
      "/pair",
      "/terminal",
      "/health",
    ],
    "html_handling": "none",
    "not_found_handling": "404-page",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SANDBOX",
        "class_name": "ScottySandbox",
      },
      {
        "name": "AUTH",
        "class_name": "ScottyAuthRegistry",
      },
      {
        "name": "RUNNER_REGISTRY",
        "class_name": "ScottyRunnerRegistry",
      },
      {
        "name": "SANDBOX_CONFIG",
        "class_name": "ScottySandboxConfig",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScottySandbox"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ScottyAuthRegistry"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ScottyRunnerRegistry", "ScottySandboxConfig"],
    },
  ],
  "containers": [
    {
      "class_name": "ScottySandbox",
      "image": "./container/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-2",
      "max_instances": 10,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "scotty-backups",
    },
    {
      "binding": "ARTIFACT_BUCKET",
      "bucket_name": "scotty-artifacts",
    },
    {
      "binding": "SANDBOX_BUNDLE_BUCKET",
      "bucket_name": "scotty-sandbox-bundles",
    },
  ],
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    "BACKUP_BUCKET_NAME": "scotty-backups",
  },
}
