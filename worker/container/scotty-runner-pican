#!/usr/bin/env bash

set -euo pipefail

token_file="/run/scotty/credentials/pican-proxy-token"
if [[ ! -r "${token_file}" ]]; then
  echo "Pican proxy credential is not available" >&2
  exit 1
fi

proxy_token="$(<"${token_file}")"
if [[ ! "${proxy_token}" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
  echo "Pican proxy credential is invalid" >&2
  exit 1
fi

export PICAN_PROXY_TOKEN="${proxy_token}"
exec /usr/local/bin/pican "$@"
