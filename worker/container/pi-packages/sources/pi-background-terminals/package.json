{
  "name": "pi-background-terminals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types extensions/background-terminals/manager.test.ts extensions/background-terminals/output.test.ts extensions/background-terminals/prompt.test.ts extensions/background-terminals/result-delivery.test.ts extensions/background-terminals/ps.test.ts",
    "format": "prettier --write \"extensions/**/*.ts\" \"skills/**/*.md\" \"*.{json,md}\"",
    "format:check": "prettier --check \"extensions/**/*.ts\" \"skills/**/*.md\" \"*.{json,md}\""
  },
  "pi": {
    "extensions": [
      "./extensions/background-terminals/index.ts"
    ],
    "skills": [
      "./skills/background-terminals"
    ]
  },
  "dependencies": {
    "effect": "4.0.0-beta.98"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@earendil-works/pi-tui": "^0.80.7",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  }
}
