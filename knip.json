{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "alchemy.run.ts",
        "cli/scotty.ts",
        "scripts/*.mjs",
        "scripts/lab/*.mjs",
        "scripts/release/*.mjs",
        "scripts/build/*.mjs",
        "e2e/scripts/**/*.mjs",
        "e2e/tests/*.test.mjs",
        "protocol/**/*.ts",
        "infra/test/**/*.test.ts",
        "e2e/canary/*.test.ts",
        "e2e/canary/*.run.ts",
        "e2e/canary/full-stack-canary-worker.ts"
      ],
      "project": ["cli/**/*.ts", "e2e/canary/**/*.ts", "infra/**/*.ts", "protocol/**/*.ts"],
      "ignoreDependencies": ["cloudflare", "@informalsystems/quint"]
    },
    "worker": {
      "entry": ["test/**/*.test.ts", "src/agent/codex/main.ts", "src/agent/claude/server.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["smol-toml"]
    }
  },
  "ignore": ["worker/container/**"]
}
