{
  "name": "scotty",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "bin": {
    "scotty": "cli/main.ts"
  },
  "workspaces": [
    "ui"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --disable-nested-config --write .",
    "fmt:check": "oxfmt --disable-nested-config --check .",
    "lint": "oxlint --disable-nested-config",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace @scotty/ui",
    "ui:dev": "npm run dev --workspace @scotty/ui",
    "ui:build": "npm run build --workspace @scotty/ui",
    "test": "vitest run",
    "e2e": "bun e2e/run.ts",
    "protocol:codex": "bun container/scripted/codex-protocol.gen.ts",
    "scotty": "bun cli/main.ts",
    "compile": "bun deploy/compile.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@clack/prompts": "1.8.1",
    "@distilled.cloud/cloudflare": "1.0.0-rc.12",
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/sql-sqlite-do": "4.0.0-rc.117",
    "@modelcontextprotocol/client": "2.0.0",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.117",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.79",
    "@effect/vitest": "4.0.0-rc.117",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "rolldown": "1.2.5",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
