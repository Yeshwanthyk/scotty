{
  "name": "scotty",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yeshwanthyk/scotty.git"
  },
  "workspaces": [
    "worker",
    "pi-scotty"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/apply-dependency-patches.mjs",
    "check": "npm run check:effect-version && npm run check:pi-packages && npm run check:pi-scotty && npm run check:desktop && npm run fmt:check && npm run lint && npm run typecheck && npm run test:all && node e2e/scripts/scan.mjs",
    "check:effect-version": "node e2e/scripts/check-effect-version.mjs",
    "check:pi-packages": "node scripts/check-pi-packages.mjs",
    "check:pi-scotty": "node scripts/check-pi-scotty-independence.mjs",
    "check:desktop:source": "node scripts/check-scotty-desktop.mjs",
    "check:desktop": "npm run check:desktop:source && npm run check:desktop:build",
    "check:desktop:build": "node scripts/check-scotty-desktop-build.mjs",
    "fmt": "oxfmt --disable-nested-config --write .",
    "fmt:check": "oxfmt --disable-nested-config --check .",
    "lint": "npm run lint:skills && oxlint --disable-nested-config --deny-warnings .",
    "lint:skills": "node scripts/check-lint-skills.mjs",
    "typecheck": "npm run typecheck:worker && npm run typecheck:contracts && npm run typecheck:cli && npm run typecheck:pi-scotty",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "typecheck:contracts": "tsc -p spikes/tsconfig.json",
    "typecheck:cli": "tsc -p cli/tsconfig.json",
    "typecheck:pi-scotty": "npm run typecheck --workspace @scotty/pi-scotty",
    "test": "npm run test:contracts",
    "test:contracts": "vitest run spikes",
    "test:worker": "vitest run worker/test",
    "test:cli": "vitest run cli/effect-test && bun test cli/test",
    "test:pi-scotty": "npm run check:pi-scotty && npm run test --workspace @scotty/pi-scotty",
    "test:e2e": "npm run test:e2e:offline",
    "test:e2e:offline": "node --test e2e/tests/cli-lifecycle.test.mjs e2e/tests/protocol-security.test.mjs e2e/tests/local-live-script.test.mjs",
    "test:e2e:local-live": "node e2e/scripts/local-live.mjs",
    "test:e2e:deployed-routes": "node --test e2e/tests/deployed-routes.test.mjs",
    "test:e2e:deployed": "SCOTTY_E2E_EXPLICIT=1 node --test e2e/tests/deployed.test.mjs",
    "test:ops": "node --test scripts/*.test.mjs",
    "test:all": "npm run test:contracts && npm run test:worker && npm run test:cli && npm run test:pi-scotty && npm run test:e2e:offline && npm run test:ops",
    "audit:containers": "node scripts/reconcile-containers.mjs",
    "build": "npm run build:cli && npm run build:pi-scotty",
    "build:cli": "bun scripts/build-cli.mjs",
    "build:pi-scotty": "npm run build --workspace @scotty/pi-scotty",
    "build:desktop-sidecar": "node scripts/build-scotty-desktop-sidecar.mjs",
    "build:desktop": "node scripts/package-scotty-desktop.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "probe:dry-run": "wrangler deploy --dry-run --config spikes/wrangler.jsonc",
    "worker:dev": "npm run dev --workspace @scotty/worker"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "0.29.1",
    "@effect/platform-bun": "4.0.0-beta.103",
    "@effect/platform-node": "4.0.0-beta.103",
    "alchemy": "2.0.0-beta.67",
    "effect": "4.0.0-beta.103",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260719.1",
    "@effect/vitest": "4.0.0-beta.103",
    "@types/bun": "1.3.14",
    "@types/node": "24.0.15",
    "@types/proper-lockfile": "^4.1.4",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
