{
  "name": "scotty",
  "version": "0.3.9",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yeshwanthyk/scotty.git"
  },
  "workspaces": [
    "worker"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/apply-dependency-patches.mjs",
    "check": "npm run check:effect-version && npm run check:pi-packages && npm run check:patches && npm run check:wrangler-bindings && npm run check:cli-compiled && npm run fmt:check && npm run lint && npm run knip:check && npm run typecheck && npm run test:all && node e2e/scripts/scan.mjs",
    "check:cli-compiled": "node scripts/check-cli-compiled.mjs",
    "check:patches": "node scripts/apply-dependency-patches.mjs --check",
    "check:wrangler-bindings": "node scripts/check-wrangler-bindings.mjs",
    "check:cli-clean-room": "node scripts/check-cli-clean-room.mjs",
    "check:cli-standalone-deploy": "node scripts/check-cli-standalone-deploy.mjs",
    "check:container-image": "node scripts/check-container-image.mjs",
    "check:effect-version": "node e2e/scripts/check-effect-version.mjs",
    "check:pi-packages": "node scripts/check-pi-packages.mjs",
    "fmt": "oxfmt --disable-nested-config --write .",
    "fmt:check": "oxfmt --disable-nested-config --check .",
    "lint": "npm run lint:skills && oxlint --disable-nested-config --deny-warnings .",
    "lint:skills": "node scripts/check-lint-skills.mjs",
    "lab": "bun scripts/scotty-lab.ts",
    "preview:ui": "node scripts/ui-preview.mjs",
    "test:ui-preview": "node --test scripts/ui-preview-state.test.mjs",
    "typecheck": "npm run typecheck:worker && npm run typecheck:contracts && npm run typecheck:cli && npm run typecheck:lab",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "typecheck:contracts": "tsc -p tsconfig.contracts.json",
    "typecheck:cli": "tsc -p cli/tsconfig.json",
    "typecheck:lab": "tsc -p scripts/tsconfig.lab.json",
    "test": "npm run test:contracts",
    "test:contracts": "vitest run infra/test e2e/canary scripts/oxlint-plugin-scotty/plugin.test.js",
    "test:worker": "vitest run worker/test",
    "test:cli": "vitest run cli/effect-test && bun test cli/test",
    "test:e2e:static": "node --test e2e/tests/protocol-security.test.mjs",
    "test:e2e:local-live": "node e2e/scripts/local-live.mjs",
    "test:e2e:local-live:helpers": "node --test e2e/tests/local-live-script.test.mjs",
    "test:e2e:deployed-routes": "node --test e2e/tests/deployed-routes.test.mjs",
    "test:e2e:deployed": "SCOTTY_E2E_EXPLICIT=1 node --test e2e/tests/deployed.test.mjs",
    "test:lab": "vitest run scripts/scotty-lab.test.ts",
    "test:ops": "node --test scripts/*.test.mjs",
    "test:all": "npm run test:contracts && npm run test:worker && npm run test:cli && npm run test:lab && npm run test:e2e:static && npm run test:e2e:local-live:helpers && npm run test:ops",
    "audit:containers": "node scripts/reconcile-containers.mjs",
    "build": "npm run build:cli",
    "build:cli": "bun scripts/build-cli.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "probe:dry-run": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "worker:dev": "npm run dev --workspace @scotty/worker",
    "knip": "knip",
    "knip:check": "knip --exclude exports,types"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@distilled.cloud/cloudflare": "1.0.0-rc.4",
    "@effect/platform-bun": "4.0.0-rc.109",
    "@effect/platform-node": "4.0.0-rc.109",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.109",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@cloudflare/sandbox": "0.12.3",
    "@cloudflare/workers-types": "5.20260719.1",
    "@effect/vitest": "4.0.0-rc.109",
    "@types/bun": "1.3.14",
    "@types/node": "24.0.15",
    "@types/proper-lockfile": "^4.1.4",
    "acorn": "8.18.0",
    "knip": "^6.32.3",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
