{
  "name": "scotty",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "scotty": "cli/main.ts"
  },
  "workspaces": [
    "ui"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --disable-nested-config --write .",
    "fmt:check": "oxfmt --disable-nested-config --check .",
    "lint": "oxlint --disable-nested-config && npm run --silent vendor:check",
    "vendor:check": "node scripts/check-vendor.ts",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace @scotty/ui",
    "ui:dev": "npm run dev --workspace @scotty/ui",
    "ui:build": "npm run build --workspace @scotty/ui",
    "test": "vitest run",
    "e2e": "bun e2e/run.ts",
    "protocol:codex": "bun container/scripted/codex-protocol.gen.ts",
    "scotty": "bun cli/main.ts",
    "compile": "bun deploy/compile.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@clack/prompts": "1.8.1",
    "@distilled.cloud/cloudflare": "1.0.0-rc.20",
    "@effect/platform-bun": "4.1.4",
    "@effect/sql-sqlite-do": "4.1.4",
    "@modelcontextprotocol/client": "2.0.0",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.87",
    "@effect/vitest": "4.1.4",
    "@interfere/landmines": "^0.1.0",
    "oxfmt": "0.70.0",
    "oxlint": "^1.94.0",
    "rolldown": "1.2.16",
    "tsrs": "^0.25.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
