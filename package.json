{
  "name": "scotty",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "worker"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/apply-dependency-patches.mjs",
    "check": "npm run check:effect-version && npm run check:pi-packages && npm run fmt:check && npm run lint && npm run typecheck && npm run test:all && node e2e/scripts/scan.mjs",
    "check:effect-version": "node e2e/scripts/check-effect-version.mjs",
    "check:pi-packages": "node scripts/check-pi-packages.mjs",
    "fmt": "oxfmt --disable-nested-config --write .",
    "fmt:check": "oxfmt --disable-nested-config --check .",
    "lint": "npm run lint:skills && oxlint --disable-nested-config --deny-warnings .",
    "lint:skills": "node scripts/check-lint-skills.mjs",
    "typecheck": "npm run typecheck:worker && npm run typecheck:contracts && npm run typecheck:cli",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "typecheck:contracts": "tsc -p spikes/tsconfig.json",
    "typecheck:cli": "tsc -p cli/tsconfig.json",
    "test": "npm run test:contracts",
    "test:contracts": "vitest run spikes",
    "test:worker": "vitest run worker/test",
    "test:cli": "vitest run cli/effect-test && bun test cli/test",
    "test:e2e": "npm run test:e2e:offline",
    "test:e2e:offline": "node --test e2e/tests/cli-lifecycle.test.mjs e2e/tests/protocol-security.test.mjs e2e/tests/local-live-script.test.mjs",
    "test:e2e:local-live": "node e2e/scripts/local-live.mjs",
    "test:e2e:deployed-routes": "node --test e2e/tests/deployed-routes.test.mjs",
    "test:e2e:deployed": "SCOTTY_E2E_EXPLICIT=1 node --test e2e/tests/deployed.test.mjs",
    "test:ops": "node --test scripts/*.test.mjs",
    "test:all": "npm run test:contracts && npm run test:worker && npm run test:cli && npm run test:e2e:offline && npm run test:ops",
    "audit:containers": "node scripts/reconcile-containers.mjs",
    "build:cli": "bun scripts/build-cli.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "probe:dry-run": "wrangler deploy --dry-run --config spikes/wrangler.jsonc",
    "worker:dev": "npm run dev --workspace @scotty/worker"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "0.29.1",
    "@effect/platform-bun": "4.0.0-beta.99",
    "@effect/platform-node": "4.0.0-beta.99",
    "alchemy": "2.0.0-beta.63",
    "effect": "4.0.0-beta.99",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260719.1",
    "@effect/vitest": "4.0.0-beta.99",
    "@types/bun": "1.3.14",
    "@types/node": "24.0.15",
    "@types/proper-lockfile": "^4.1.4",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
