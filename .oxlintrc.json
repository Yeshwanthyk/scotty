{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [{ "name": "scotty", "specifier": "./scripts/oxlint-plugin-scotty.js" }],
  "ignorePatterns": [
    ".pi/**",
    ".wrangler/**",
    "dist/**",
    "**/node_modules/**",
    "vendor/**",
    "work/**",
    "worker/container/pi-packages/sources/scotty-browser-test/**",
    "worker/public/vendor/**"
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "complexity": ["error", { "max": 20 }],
    "typescript/no-explicit-any": "error",
    "no-debugger": "error",
    "scotty/no-conditional-tests": "error",
    "scotty/no-double-cast": "error",
    "scotty/no-effect-escape-hatch": "error",
    "scotty/no-effect-run-sync-in-tests": "error",
    "scotty/no-inline-object-type-assertion": "error",
    "scotty/no-inline-schema-compile": "error",
    "scotty/no-manual-tag-check": "error",
    "scotty/no-match-orelse": "error",
    "scotty/no-promise-client-surface": "error",
    "scotty/no-record-string-unknown": "error",
    "scotty/no-raw-error-throw": "error",
    "scotty/no-redundant-error-factory": "error",
    "scotty/no-redundant-primitive-cast": "error",
    "scotty/no-schema-class": "error",
    "scotty/no-switch-statement": "error",
    "scotty/no-ts-nocheck": "error",
    "scotty/no-unsupported-effect-api": "error",
    "scotty/prefer-effect-predicate": "error",
    "scotty/prefer-schema-inferred-types": "error",
    "scotty/prefer-value-inferred-extension-types": "error"
  },
  "overrides": [
    {
      "files": [
        "cli/scotty.ts",
        "cli/src/**/*.ts",
        "scripts/scotty-lab.ts",
        "infra/**/*.ts",
        "protocol/**/*.ts",
        "worker/src/evidence/artifact-store.ts",
        "worker/src/evidence/store.ts",
        "worker/src/evidence/workflow.ts",
        "worker/src/repos/verifier.ts",
        "worker/src/**/*.ts",
        "alchemy.run.ts",
        "e2e/canary/full-stack-canary.run.ts",
        "e2e/canary/full-stack-canary.ts"
      ],
      "rules": {
        "scotty/no-direct-do-storage": "error",
        "scotty/no-effect-internal-tags": "error",
        "scotty/no-effect-runtime-escape": "error",
        "scotty/no-error-constructor": "error",
        "scotty/no-error-subclass": "error",
        "scotty/no-instanceof-error": "error",
        "scotty/no-instanceof-tagged-error": "error",
        "scotty/no-json-parse": "error",
        "scotty/no-promise-catch": "error",
        "scotty/no-promise-reject": "error",
        "scotty/no-raw-error-throw": "off",
        "scotty/no-raw-fetch": "error",
        "scotty/no-raw-wall-clock": "error",
        "scotty/no-try-catch-or-throw": "error",
        "scotty/no-unknown-error-message": "error"
      }
    },
    {
      "files": ["worker/src/**/*.ts"],
      "rules": {
        "scotty/no-storage-key-literal": "error"
      }
    },
    {
      "files": ["worker/test/**/*.ts"],
      "rules": {
        "scotty/no-raw-wall-clock": "error"
      }
    },
    {
      "files": ["worker/public/**/*.js"],
      "env": {
        "browser": true
      },
      "rules": {
        "scotty/no-browser-persistence": "error",
        "scotty/no-browser-rpc-path": "error",
        "scotty/no-promise-catch": "off",
        "scotty/no-unsafe-dom-html-sink": "error"
      }
    },
    {
      "files": ["worker/src/session/object.ts"],
      "rules": {
        "scotty/no-raw-error-throw": "error",
        "scotty/no-try-catch-or-throw": "error"
      }
    },
    {
      "files": ["worker/src/index.ts"],
      "rules": {
        "scotty/no-effect-runtime-escape": "off",
        "scotty/no-instanceof-error": "off",
        "scotty/no-instanceof-tagged-error": "off",
        "scotty/no-promise-catch": "off",
        "scotty/no-try-catch-or-throw": "off",
        "scotty/no-unknown-error-message": "off"
      }
    },
    {
      "files": ["worker/src/auth/request.ts"],
      "rules": {
        "scotty/no-raw-wall-clock": "off",
        "scotty/no-try-catch-or-throw": "off"
      }
    }
  ]
}
